{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist-src",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "rewriteRelativeImportExtensions": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "imapflow": ["./node_modules/imapflow"],
      "nodemailer": ["./node_modules/nodemailer"],
      "keytar": ["./node_modules/keytar"]
    }
  },
  "include": [
    "main.ts",
    "tray.ts",
    "gateway-manager.ts",
    "auto-updater.ts",
    "dashboard-window.ts",
    "../onboarding/index.ts",
    "../onboarding/server.ts",
    "../onboarding/state.ts",
    "../onboarding/env-writer.ts",
    "../onboarding/validators.ts",
    "../onboarding/tailscale.ts",
    "../dashboard/server.ts",
    "../dashboard/index.ts",
    "../config/system-prompt.ts",
    "../lib/model-adapter.ts",
    "../lib/skill-registry.ts",
    "../recipes/store.ts",
    "../recipes/types.ts",
    "../recipes/library/index.ts",
    "../recipes/library/morning-inbox.ts",
    "../recipes/library/daily-briefing.ts",
    "../recipes/library/overdue-leads.ts",
    "../recipes/library/lead-followup.ts",
    "../recipes/library/file-watcher.ts",
    "../recipes/library/weekly-summary.ts",
    "../security/audit-logger.ts",
    "../security/permissions.ts",
    "../token-tracker/store.ts",
    "../token-tracker/pricing.ts",
    "../undo/registry.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-src",
    "assets",
    "../../extensions/**/*",
    "../../src/**/*",
    "../../ui/**/*",
    "../../test/**/*",
    "../../dist/**/*"
  ]
}
