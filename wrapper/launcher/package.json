{
  "name": "armorclaw-launcher",
  "version": "0.1.0",
  "description": "ArmorClaw desktop launcher — system tray app",
  "author": "ArmorClaw <hello@armorclaw.ai>",
  "type": "module",
  "main": "dist-src/launcher/main.js",
  "scripts": {
    "build:all": "npm run build:ts && electron-builder --mac --win",
    "build:mac": "npm run build:ts && electron-builder --mac",
    "build:ts": "tsc; node scripts/copy-wizard-public.mjs",
    "build:win": "npm run build:ts && electron-builder --win",
    "check:openclaw-pin": "bash ../security/openclaw-pin/check-pin.sh",
    "prebuild:all": "npm run check:openclaw-pin",
    "prebuild:mac": "npm run check:openclaw-pin",
    "prebuild:win": "npm run check:openclaw-pin",
    "start": "npm run build:ts && electron .",
    "test:security": "cd .. && npx vitest run tests/unit/security/",
    "test:smoke": "cd .. && npx vitest run tests/smoke/dashboard-smoke.test.ts",
    "test:undo": "cd .. && npx vitest run tests/unit/undo/"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "electron-updater": "^6.8.3",
    "express": "^5.1.0",
    "imapflow": "^1.0.169",
    "keytar": "^7.9.0",
    "nodemailer": "^6.9.16",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^6.4.17",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
